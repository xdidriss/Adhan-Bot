    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.2.0",
    "luxon": "^3.5.0",
    "opusscript": "^0.0.8",
    "tweetnacl": "^1.0.3"
  }
