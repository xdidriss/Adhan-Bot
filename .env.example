DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
CLIENT_SECRET=your_application_client_secret_here
# Web dashboard base URL and port (also add WEB_BASE_URL/auth/callback in Discord OAuth2 redirect URLs).
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000
# Optional: seconds between Discord OAuth profile/guild refresh calls in dashboard.
DASHBOARD_DISCORD_SYNC_SECONDS=90
# Session signing secret for dashboard login cookies.
SESSION_SECRET=replace_with_a_long_random_secret
# Optional: folder for persisted dashboard sessions (recommended in production).
SESSION_STORE_PATH=data/sessions
# Optional: dashboard session TTL in seconds (default 7 days).
SESSION_TTL_SECONDS=604800
# Optional: how often expired sessions are cleaned up in seconds.
SESSION_REAP_INTERVAL_SECONDS=3600
# Optional: share the session across subdomains (e.g. www + apex) to avoid OAuth state mismatch.
# Example: SESSION_COOKIE_DOMAIN=adhan-bot.online
SESSION_COOKIE_DOMAIN=
# Optional: privacy contact shown on /privacy (email, Discord tag, etc.).
PRIVACY_CONTACT=
# Optional: encrypt stored runtime data on disk (64 hex chars or base64 for 32 bytes).
DATA_ENCRYPTION_KEY=
# Discord OAuth2 permissions integer used in invite URL generation.
BOT_PERMISSIONS=2322443439053888
# Optional: set this to register slash commands instantly in one server during testing.
GUILD_ID=
# Optional: custom adhan audio path. Defaults to assets/adhan.mp3
ADHAN_AUDIO_FILE=assets/adhan.mp3
# Optional: scheduler interval in seconds.
CHECK_INTERVAL_SECONDS=20
# Optional: dashboard rate-limit controls.
WEB_RATE_LIMIT_WINDOW_MS=900000
WEB_RATE_LIMIT_MAX_PUBLIC=600
WEB_RATE_LIMIT_MAX_AUTH=40
WEB_RATE_LIMIT_MAX_POST=120
